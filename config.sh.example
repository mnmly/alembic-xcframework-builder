# Personal config for alembic-xcframework-builder.
# Copy to config.sh and edit. config.sh is gitignored.

# Homebrew prefix for Imath. Alembic links against Imath::Imath.
IMATH_PREFIX="$(brew --prefix imath 2>/dev/null || echo /opt/homebrew/opt/imath)"

# Optional: codesign identity. Leave empty to skip codesign.
CODESIGN_IDENTITY=""
# Example:
# CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Where the final Alembic.xcframework + zip should be written.
OUTPUT_DIR="${OUTPUT_DIR:-$(pwd)/output}"

# Optional: mirror the xcframework into a Swift package's Frameworks dir.
SWIFT_PACKAGE_FRAMEWORKS_DIR=""
# Example:
# SWIFT_PACKAGE_FRAMEWORKS_DIR="/Users/you/Development-local/Personal/SwiftAlembic/Frameworks"

# Optional: GitHub repo (owner/name) for `make release`. Leave empty to skip.
GH_RELEASE_REPO=""

# Architectures (currently only arm64 is tested).
ARCHS="arm64"

# macOS deployment target.
DEPLOYMENT_TARGET="26.0"

# Enable HDF5 backend (requires `brew install hdf5`). OFF by default —
# Ogawa is the modern Alembic backend and HDF5 is legacy/optional.
USE_HDF5="OFF"

# Override the git tag if Alembic's tagging convention changes.
# Leave empty to auto-detect (<version> then v<version>).
ALEMBIC_TAG=""

# Extra cmake flags appended to the configure step.
EXTRA_CMAKE_FLAGS=""

# Search paths for dylibbundler (e.g. Imath, optional HDF5).
DYLIBBUNDLER_SEARCH_PATHS="/opt/homebrew/lib /opt/homebrew/opt/imath/lib"
