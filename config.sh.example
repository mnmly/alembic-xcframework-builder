# Personal config for alembic-xcframework-builder.
# Copy to config.sh and edit. config.sh is gitignored.

# Which slices to build. Drop any you don't need to speed up the build.
# Supported: macos ios ios-sim visionos visionos-sim tvos tvos-sim
PLATFORMS="macos ios ios-sim visionos visionos-sim tvos tvos-sim"

# Imath release vendored for every slice. Pinning this ensures every slice
# in the xcframework uses the same IMATH_INTERNAL_NAMESPACE (Imath_3_1, etc.)
# so consumer C++ shims built against one slice's headers link cleanly against
# any other slice's binary.
IMATH_VERSION="3.1.12"

# Optional: codesign identity. Applies to the macOS slice only (static
# frameworks for iOS/visionOS/tvOS are re-signed by Xcode on Embed & Sign).
CODESIGN_IDENTITY=""
# Example:
# CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Where the final Alembic.xcframework + zip should be written.
OUTPUT_DIR="${OUTPUT_DIR:-$(pwd)/output}"

# Optional: mirror the xcframework into a Swift package's Frameworks dir.
SWIFT_PACKAGE_FRAMEWORKS_DIR=""
# Example:
# SWIFT_PACKAGE_FRAMEWORKS_DIR="/Users/you/Development-local/Personal/SwiftAlembic/Frameworks"

# Optional: GitHub repo (owner/name) for `make release`. Leave empty to skip.
GH_RELEASE_REPO=""

# Per-platform minimum OS versions.
MACOSX_DEPLOYMENT_TARGET="26.0"
IOS_DEPLOYMENT_TARGET="17.0"
VISIONOS_DEPLOYMENT_TARGET="2.0"
TVOS_DEPLOYMENT_TARGET="17.0"

# Override the Alembic git tag if upstream tagging convention changes.
# Leave empty to auto-detect (<version> then v<version>).
ALEMBIC_TAG=""

# Extra cmake flags appended to every Alembic configure step.
EXTRA_CMAKE_FLAGS=""
